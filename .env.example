# Copy this file to .env and fill in your values

ANTHROPIC_API_KEY=your-api-key-here
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Public base URL of this platform (used for absolute links in alert emails)
SITE_URL=https://sociallight.africa

# Free trial — length of the self-service trial started from /signup/, and where
# package requests raised from the paywall are emailed (comma-separated).
TRIAL_PERIOD_DAYS=14
SALES_NOTIFICATION_EMAILS=sales@sociallight.africa

# ── Onboarding ───────────────────────────────────────────────────────────────
# How long an email-verification link stays valid. An expired link can be
# replaced from the verify step; nobody is stranded by one.
EMAIL_VERIFICATION_TTL_HOURS=48

# ── Entitlements ─────────────────────────────────────────────────────────────
# Optional. What an account with no paid package can do, and what the free trial
# unlocks. Leave both unset for the defaults: free = basic monitoring, dashboard
# and alerts; trial = everything. Comma-separated feature codes — the full list
# is in monitor/entitlements.py and is shown as tick boxes on every package in
# the Django admin.
# FREE_PLAN_ENTITLEMENTS=basic_monitoring,dashboard,alerts
# TRIAL_ENTITLEMENTS=

# ── Payments ─────────────────────────────────────────────────────────────────
# The master switch. Off by default, which is the current production behaviour:
# fees are settled off-platform by invoice/EFT and a platform admin activates the
# package from the Django admin. With it off, onboarding still completes, plans
# are still assignable and every entitlement still applies — the only thing that
# does not happen is card capture. Nothing requires a gateway to be configured.
PAYMENTS_ENABLED=False
# Which gateway when payments are on: manual | stripe | dotted.path.To.Provider
PAYMENT_PROVIDER=manual

# Stripe, if PAYMENT_PROVIDER=stripe. Card details are entered into Stripe's own
# hosted field in the browser and never reach this application — we store only
# the payment-method token. Requires: pip install stripe
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Business rule: how many days after a payment its funds are treated as eligible
# for extraction. Stamped onto each payment when it is taken, so changing this
# affects future payments only. It describes OUR holding period — the payment
# provider's own settlement timetable is separate and is not controlled here.
PAYMENT_SETTLEMENT_HOLD_DAYS=7

# ── Transport security ───────────────────────────────────────────────────────
# These default to on whenever DEBUG=False, and off in development so local http
# keeps working. Set them explicitly only to override that.
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SESSION_COOKIE_AGE=1209600

# mediahost clips API — single global key (x-api-key). Clips route to orgs by
# matching their `search` term to each org's keywords. Blank key = import off.
MEDIAHOST_API_URL=http://mh-api.mediahost.co.za
MEDIAHOST_API_KEY=
MEDIAHOST_TIMEOUT=120

# Celery (Redis broker). In docker-compose use the service name: redis://redis:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=django-db

# ── Email ──────────────────────────────────────────────────────
# Onboarding depends on this: a new account cannot reach the product until it
# follows the verification link, so if email does not work, nobody can sign up.
# Check what is configured, and prove it delivers, with:
#     python manage.py test_email you@example.com
#
# Delivery is plain SMTP. Nothing below is tied to a particular mail provider —
# point EMAIL_HOST at a hosted mail service or at your own server and the rest of
# the application is unchanged.
DEFAULT_FROM_EMAIL="Social Light <noreply@sociallight.africa>"
SERVER_EMAIL="noreply@sociallight.africa"

# Route 1 — SMTP (the default, and what production uses).
#   The host and username below are PLACEHOLDERS and are rejected before any send
#   is attempted. Replace all four with your provider's values. Most providers
#   issue an application-specific password rather than accepting the account
#   password, and most require DEFAULT_FROM_EMAIL to be a domain or mailbox the
#   account is allowed to send as.
#
#   Ports: 587 with EMAIL_USE_TLS=True, or 465 with EMAIL_USE_SSL=True.
#   Set exactly one of the two — never both.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-provider.example
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Seconds to wait on the mail server before giving up.
EMAIL_TIMEOUT=20

# Route 2 — development only. Prints the whole message, verification link
#   included, to the terminal and sends nothing anywhere. Use this to test the
#   onboarding flow without a mail account.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
