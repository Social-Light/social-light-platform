# Copy this file to .env and fill in your values

ANTHROPIC_API_KEY=your-api-key-here
# Groq — sentiment AI (monitor/sentiment_ai.py) + report_ai.py/sector_ai.py/
# issue_report_ai.py. Free tier: 200,000 tokens/day, shared across all four.
GROQ_API_KEY=
# Optional additional accounts' keys — sentiment_ai.py's analyze_sentiment()
# and date_ai.py's extract_published_date() automatically fall back through
# these in order if a request on an earlier key fails (typically once that
# account's daily token cap is hit). Leave blank to run on fewer accounts.
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_KEY_7=
# Dedicated to date_ai.py's extract_published_date() ONLY (re-dating social
# posts to their real publish date) — never read by sentiment_ai.py. Keeps
# date re-labelling from competing with sentiment analysis for quota.
GROQ_API_KEY_DATE_1=
GROQ_API_KEY_DATE_2=
# Dedicated to report_ai.py/issue_report_ai.py ONLY (the "Generate AI
# Analysis"/issue-report features) — spent only as a last resort, after the
# shared pool above, so it never competes with live sentiment analysis.
GROQ_API_KEY_REPORTS=
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Public base URL of this platform (used for absolute links in alert emails)
SITE_URL=https://sociallight.africa

# Free trial — length of the self-service trial started from /signup/, and where
# package requests raised from the paywall are emailed (comma-separated).
TRIAL_PERIOD_DAYS=14
SALES_NOTIFICATION_EMAILS=sales@sociallight.africa

# mediahost clips API — single global key (x-api-key). Clips route to orgs by
# matching their `search` term to each org's keywords. Blank key = import off.
MEDIAHOST_API_URL=http://mh-api.mediahost.co.za
MEDIAHOST_API_KEY=
MEDIAHOST_TIMEOUT=120

# ISO date (YYYY-MM-DD); analyze_sentiment only AI-analyses mentions published
# on/after this date, leaving older unanalysed rows alone. Blank = no cutoff
# (analyses the entire historical backlog, the old default).
SENTIMENT_AI_CUTOFF_DATE=

# Celery (Redis broker). In docker-compose use the service name: redis://redis:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=django-db

# Email — Resend via Anymail (HTTP API)
EMAIL_BACKEND=anymail.backends.resend.EmailBackend
RESEND_API_KEY=re_your_resend_api_key_here
DEFAULT_FROM_EMAIL="Social Light <support@sociallightbw.com>"
SERVER_EMAIL="support@sociallightbw.com"
